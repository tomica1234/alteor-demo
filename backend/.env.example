ALTEOR_DATA_DIR=./data
ALTEOR_LLM_BASE_URL=http://127.0.0.1:8000/v1
ALTEOR_LLM_MODEL=local
ALTEOR_LLM_API_KEY=local
ALTEOR_LLM_TIMEOUT_SECONDS=420
ALTEOR_ALLOW_EXTERNAL_CONNECTORS=false

# Live connector tokens are read only from environment variables. The values
# below are examples of variable names, not credentials.
ALTEOR_GOOGLE_TOKEN=
ALTEOR_MICROSOFT_TOKEN=
ALTEOR_DMS_TOKEN=
ALTEOR_CASE_DB_TOKEN=

